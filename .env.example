# ============================================================
# Nebulosa Telegram Bot – Environment Variables
# Copy to .env for local dev; set via Railway/Vercel dashboards
# in production. NEVER commit .env to git.
# ============================================================

# ----------------------------------------------------------
# REQUIRED – both Railway and Vercel
# ----------------------------------------------------------

# Telegram Bot API token (from @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Zoom OAuth App credentials
ZOOM_CLIENT_ID=YOUR_ZOOM_CLIENT_ID
ZOOM_CLIENT_SECRET=YOUR_ZOOM_CLIENT_SECRET

# Full OAuth callback URL registered in the Zoom app dashboard
# (must match exactly – include /oauth/callback path)
ZOOM_REDIRECT_URI=https://YOUR_RAILWAY_APP.railway.app/oauth/callback

# ----------------------------------------------------------
# REQUIRED – Railway only
# ----------------------------------------------------------

# Railway sets this automatically, but you can override
RAILWAY_STATIC_URL=nebulosa-production.railway.app

# ----------------------------------------------------------
# RECOMMENDED – security hardening
# ----------------------------------------------------------

# Random 32-byte hex string to validate Telegram webhook POSTs
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Secret for the /register-webhook admin endpoint (Vercel)
ADMIN_SECRET=

# ----------------------------------------------------------
# OPTIONAL – Vercel / Railway
# ----------------------------------------------------------

# HTTP port (Railway sets this automatically)
PORT=3000

# Vercel deployment URL (auto-set by Vercel as VERCEL_URL)
# Set manually if you have a custom domain
VERCEL_URL=

# Override Railway backend URL used by Vercel functions
RAILWAY_BACKEND=https://nebulosa-production.railway.app

# ----------------------------------------------------------
# OPTIONAL – Telegram admin features
# ----------------------------------------------------------

# Telegram user ID of the bot admin
ADMIN_USER_ID=

# Telegram channel ID for structured logs
LOG_CHANNEL_ID=
