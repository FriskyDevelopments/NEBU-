# Stix Magic – environment variables

# Required: Telegram Bot API token (get from @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Optional: HTTP server port (default: 3000)
PORT=3000

# Optional: Set to enable webhook mode (e.g. https://yourapp.railway.app)
# If not set, the bot runs in polling mode (useful for local dev)
WEBHOOK_URL=

# Zoom OAuth Credentials
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=

# Security: webhook verification (fail-closed when set — required in production)
TELEGRAM_WEBHOOK_SECRET=  # Shared secret for Telegram webhook X-Telegram-Bot-Api-Secret-Token

# Security: shared secret for bot API user/subscription routes (stixmagic)
BOT_API_SHARED_SECRET=

# Optional: Telegram user ID allowed to run owner/admin commands (gated, fail-closed)
OWNER_ID=

# Optional: control chat ID for supergroup migration notices
CONTROL_CHAT_ID=
