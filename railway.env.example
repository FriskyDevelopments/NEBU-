# Railway Environment Variables
# Copy these to your Railway project's environment variables

BOT_TOKEN=your_telegram_bot_token_here
AUTHORIZED_GROUP_ID=your_authorized_group_id_here

# Role-based admin permissions (see docs/admin-permissions.md).
# OWNER_ID: numeric Telegram user id of the single bot owner (owner role).
# CONTROL_CHAT_ID: numeric Telegram chat id of the control chat (control role).
# Leave blank to disable that role. Use real values in your host/secret manager
# only — never commit them.
OWNER_ID=your_owner_telegram_user_id_here
CONTROL_CHAT_ID=your_control_chat_id_here

ZOOM_USER_CLIENT_ID=your_zoom_client_id_here
ZOOM_USER_CLIENT_SECRET=your_zoom_client_secret_here
ZOOM_CLIENT_ID=your_zoom_client_id_here
ZOOM_CLIENT_SECRET=your_zoom_client_secret_here
ZOOM_REDIRECT_URI=https://pupfr.github.io/Nebulosa/zoom-callback.html
ZOOM_SECRET_TOKEN=your_zoom_secret_token_here
PORT=3000
NODE_ENV=production
RAILWAY_STATIC_URL=nebulosa-production.railway.app
